{
	"position": "bottom",
	"height": 30,
	"modules-left": [
		"sway/workspaces"
	],
	"modules-center": [
		"sway/window"
	],
	"modules-right": [
		"custom/text",
		"custom/lockscreen-status"
	],
	"custom/text": {
		"format": "Lockscreen is  "
	},
	"custom/lockscreen-status": {
        	"format": "{content}",
        	"exec": "cat /home/master/lockscreen-status.txt",
        	"interval": 2
    	}
}
