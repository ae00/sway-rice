{
	"position": "bottom",
	"height": 30,
	"modules-left": [
		"sway/workspaces"
	],
	"modules-center": [
		"sway/window"
	],
	"modules-right": [
		"custom/text",
		"idle_inhibitor"
	],
	"custom/text": {
		"format": "Screensaver is :    "
	},
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": "Off",
			"deactivated": "On"
		},
		"timeout": 30.5
	}
}
